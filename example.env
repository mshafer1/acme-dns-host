# To make public ports use a prefix, e.g. 22 for 22443 and 2253, set PORT_PREFIX (to 22)
# DNS_PORT_PREFIX=22
# WEB_PORT_PREFIX=22
# to bind to particular interface:
# DNS_PORT_PREFIX=172.17.0.1: # to bind to 172.17.0.1 interface on port 53

# May be optional; however, acme-dns stores and serves its own domain and address.
SERVER_DOMAIN=acme2.example.com
SERVER_PUBLIC_IP=1.2.3.4
# If using a proxy in front of acme-dns that sets X-Forwarded-For header, set USE_HEADER to true
# USE_HEADER=false

# admin email address, where @ is substituted with .
NS_ADMIN=admin.example.com

# Optional healthcheck domains, space separated; leave empty until TXT records are provisioned.
# Use backend-served TXT names, not the server apex or externally hosted challenge CNAMEs.
PUB_HEALTH_CHECK_DOMAINS=

INTERNAL_HEALTH_CHECK_DOMAINS=acme2.example.com
